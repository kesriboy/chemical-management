# WorkBuddy 本地工作区元数据（不进入版本库）
.workbuddy/

# 依赖与构建产物
node_modules/
dist/
build/
*.log
npm-debug.log*
yarn-error.log*

# 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

